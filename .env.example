# Sao chép file này thành .env.local rồi điền giá trị thật. KHÔNG điền token vào file này.
# Lấy bằng: turso db show <tên-db> --url
TURSO_DATABASE_URL=libsql://ten-db-cua-ban.turso.io
# Lấy bằng: turso db tokens create <tên-db>
TURSO_AUTH_TOKEN=
# Chạy thử trên máy không cần Turso: TURSO_DATABASE_URL=file:local.db
